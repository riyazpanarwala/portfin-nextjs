{
  "name": "portfin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-vm-modules prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:setup": "prisma db push && node --experimental-vm-modules prisma/seed.js",
    "postinstall": "prisma generate",
    "update-prices": "node prisma/updatePrices.js",
    "update-prices-stocks": "node prisma/updatePrices.js --stocks",
    "update-prices-mf": "node prisma/updatePrices.js --mf",
    "update-instruments": "node scripts/updateInstrumentsData.js",
    "update-instruments:watch": "node scripts/updateInstrumentsData.js --watch"
  },
  "prisma": {
    "seed": "node --experimental-vm-modules prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "csv-parse": "^6.2.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.3.3"
  },
  "type": "module"
}
